# Willcord main node behind Caddy with Caddy's internal CA.
#   WILLCORD_SITE  address browsers and workers use, e.g. plane.internal:8443
#                      or 10.0.0.5:8443; PUBLIC_BASE_URL must be https://<this>
#   WILLCORD_ROOT  release directory, e.g. /opt/willcord/current
# Optional (wrong-Host 421 page on a dedicated listener): WILLCORD_WRONG_HOST_LISTEN=:8443
# Workers trust the internal root: copy Caddy's root.crt (see docs/operations.md)
# to each worker and point SSL_CERT_FILE at it, or use /.well-known/willcord/ca.pem.
{
	# Caddy's admin API, used by `caddy reload`; local only.
	admin {$CADDY_ADMIN:localhost:2019}
	# The root is copied to workers and browsers by hand, never installed here.
	skip_install_trust
	pki {
		ca local {
			name "Willcord"
		}
	}
}

import {$WILLCORD_ROOT}/deploy/caddy/willcord-routes.caddy

{$WILLCORD_SITE} {
	tls internal
	import willcord_baremetal
}
