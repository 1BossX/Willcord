# Worker Plane main node behind Caddy with Caddy's internal CA.
#   WORKER_PLANE_SITE  address browsers and workers use, e.g. plane.internal:8443
#                      or 10.0.0.5:8443; PUBLIC_BASE_URL must be https://<this>
#   WORKER_PLANE_ROOT  release directory, e.g. /opt/worker-plane/current
# Workers trust the internal root: copy Caddy's root.crt (see docs/operations.md)
# to each worker and point SSL_CERT_FILE at it.
{
	# Caddy's admin API, used by `caddy reload`; local only.
	admin {$CADDY_ADMIN:localhost:2019}
	# The root is copied to workers and browsers by hand, never installed here.
	skip_install_trust
	pki {
		ca local {
			name "Worker Plane"
		}
	}
}

{$WORKER_PLANE_SITE} {
	tls internal

	# Public certificate only; never expose the CA directory or admin API.
	@bootstrap {
		method GET
		path /.well-known/willcord/ca.pem
	}
	handle @bootstrap {
		root * {$WORKER_PLANE_CA_ROOT:/var/lib/caddy/.local/share/caddy/pki/authorities/local}
		rewrite * /root.crt
		header Content-Type application/x-pem-file
		header Cache-Control "no-store"
		file_server
	}

	# API, login, the worker socket (WSS) and the event stream (SSE) go to the
	# main node. Responses are flushed as written, and a config reload keeps
	# open sockets for a while instead of cutting every worker off at once.
	@server path /enrollment/* /api/* /auth/* /ws/worker /health
	handle @server {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	handle {
		root * {$WORKER_PLANE_ROOT}/apps/web/dist
		try_files {path} /index.html
		file_server
	}
}
