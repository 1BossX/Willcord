# Shared Willcord HTTP routes (imported by deploy/docker/Caddyfile and
# deploy/Caddyfile.production). Placeholders:
#   WILLCORD_CA_ROOT  directory with root.crt and intermediate.crt (read-only)
#   WILLCORD_SITE     host:port browsers and workers must use
#   WILLCORD_ROOT     bare-metal release dir (systemd); docker sets WILLCORD_WEB_ROOT instead
#   WILLCORD_WEB_ROOT   static UI root (docker entrypoint sets /srv/web)

(willcord_wrong_host) {
	header Content-Type "text/html; charset=utf-8"
	header Cache-Control "no-store"
	respond <<HTML
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Host 不匹配</title>
</head>
<body style="font-family: system-ui, sans-serif; margin: 2rem; line-height: 1.5; max-width: 40rem;">
  <h1>421 — 请求的主机名不正确</h1>
  <p>请使用 <code>https://{$WILLCORD_SITE}</code> 访问控制台和 API（与 WILLCORD_SITE / PUBLIC_BASE_URL 完全一致）。</p>
  <p>根证书：<a href="https://{$WILLCORD_SITE}/.well-known/willcord/ca.pem">ca.pem</a>；中间证书：<a href="https://{$WILLCORD_SITE}/.well-known/willcord/chain.pem">chain.pem</a>。</p>
</body>
</html>
HTML 421
}

(willcord_pem) {
	@bootstrap {
		method GET
		path /.well-known/willcord/ca.pem
	}
	handle @bootstrap {
		root * {$WILLCORD_CA_ROOT:/var/lib/caddy/.local/share/caddy/pki/authorities/local}
		rewrite * /root.crt
		header Content-Type application/x-pem-file
		header Cache-Control "no-store"
		file_server
	}

	@ca_chain {
		method GET
		path /.well-known/willcord/chain.pem
	}
	handle @ca_chain {
		root * {$WILLCORD_CA_ROOT:/var/lib/caddy/.local/share/caddy/pki/authorities/local}
		rewrite * /intermediate.crt
		header Content-Type application/x-pem-file
		header Cache-Control "no-store"
		file_server
	}
}

(willcord_api) {
	@server path /enrollment/* /api/* /auth/* /ws/worker /health
	handle @server {
		reverse_proxy {$WILLCORD_UPSTREAM:127.0.0.1:3000} {
			flush_interval -1
			stream_close_delay 5m
		}
	}
}

(willcord_ui_docker) {
	handle {
		root * {$WILLCORD_WEB_ROOT:/srv/web}
		try_files {path} /index.html
		file_server
	}
}

(willcord_ui_baremetal) {
	handle {
		root * {$WILLCORD_ROOT}/apps/web/dist
		try_files {path} /index.html
		file_server
	}
}

(willcord) {
	import willcord_pem
	import willcord_api
	import willcord_ui_docker
}

(willcord_baremetal) {
	import willcord_pem
	import willcord_api
	import willcord_ui_baremetal
}
