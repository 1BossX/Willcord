# Willcord main node behind Caddy with Caddy's internal CA (container).
#   WILLCORD_SITE  address browsers and workers use, e.g. plane.internal:8443;
#                      PUBLIC_BASE_URL must be https://<this>
# The internal CA lives in /data: keep that volume, or every worker's CA file
# stops matching. Workers can fetch root.crt using a trusted CA fingerprint.
# caddy-entrypoint.sh derives WILLCORD_HOST, WILLCORD_ORIGIN and WILLCORD_PORT.
{
	skip_install_trust
	# Browsers send no SNI for an IP address; serve this host's certificate.
	default_sni {$WILLCORD_HOST:localhost}
	pki {
		ca local {
			name "Willcord"
		}
	}
}

import /etc/caddy/willcord-routes.caddy

{$WILLCORD_SITE} {
	tls internal
	import willcord
}

# Wrong Host header or SNI-only access that does not match WILLCORD_SITE.
:{$WILLCORD_PORT:8443} {
	tls internal
	import willcord_wrong_host
}

# Plain HTTP for the machine running the node. Compose publishes this port on
# 127.0.0.1 only, so it is never reachable from the network. The server only
# accepts the PUBLIC_BASE_URL origin on login and writes, so the loopback
# origins are rewritten to it (any other Origin passes through and is still
# refused), and the session cookie loses Secure, which browsers would not
# store from http (Safari does not exempt localhost).
http://localhost:8480, http://127.0.0.1:8480 {
	# The browser's Origin carries the host port from WILLCORD_LOCAL_PORT, not 8480.
	@loopback header_regexp Origin ^http://(localhost|127\.0\.0\.1):{$WILLCORD_LOCAL_PORT:8480}$
	request_header @loopback Origin {$WILLCORD_ORIGIN}
	header >Set-Cookie "(?i);\s*Secure" ""
	import willcord
}
