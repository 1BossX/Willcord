<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- /Library/LaunchDaemons/com.workerplane.worker.plist (root:wheel 0644).
     UserName is the account that owns the workspaces; commands run as it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.workerplane.worker</string>
  <key>UserName</key>
  <string>workerplane</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/worker-plane-worker</string>
    <string>/usr/local/etc/worker-plane/worker.toml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Trust the main node's internal CA (Caddy's root.crt) and nothing else. -->
    <key>SSL_CERT_FILE</key>
    <string>/usr/local/etc/worker-plane/ca.pem</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash or a fatal error, not after a clean stop. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- A revoked token exits 1; retry at most every 60 s. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <!-- SIGTERM stops running commands first; allow more than kill_grace_secs + 7 s. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>Umask</key>
  <integer>63</integer>
  <!-- launchd holds this file open for the worker's lifetime: rotate it by
       stopping the service, moving the file and starting again, never with
       newsyslog (docs/operations.md §11). -->
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/worker-plane/worker.log</string>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/worker-plane/worker.log</string>
</dict>
</plist>
