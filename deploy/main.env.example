# /etc/willcord/main.env — read by systemd as root; keep it root:root 0600.
# DATA_DIR is set by the unit (/var/lib/willcord). With Docker Compose this
# file sits beside compose.yaml; the image sets DATA_DIR, HOST and PORT.

# The exact origin browsers use; login and CSRF checks compare against it.
PUBLIC_BASE_URL=https://plane.internal:8443
PORT=3000

MODEL_PROVIDER=openrouter
MODEL_NAME=deepseek/deepseek-v4.1-flash
MODEL_API_KEY=

# First start only (at least 16 characters). Remove it after the first start.
INITIAL_ADMIN_PASSWORD=

# Optional (defaults shown).
# MAIN_RETENTION_DAYS=30
# MAIN_MIN_FREE_BYTES=1073741824
# MAIN_LOG_CAPACITY_BYTES=1073741824
# MAX_JOB_TOOL_CALLS=200
# MAX_JOB_TOKENS=2000000
# MAX_JOB_RUNTIME_SECS=14400
