[Unit]
Description=Willcord main node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=willcord
Group=willcord
EnvironmentFile=/etc/willcord/main.env
Environment=DATA_DIR=/var/lib/willcord
WorkingDirectory=/opt/willcord/current/apps/server
ExecStart=/usr/bin/env node dist/main.js
# SIGTERM closes connections, the database and the data directory lock.
KillSignal=SIGTERM
TimeoutStopSec=30
# After a crash the data directory lock (main.lock) stays behind on purpose:
# a restart would only be refused. An operator checks that no main process
# runs, removes the lock and starts the unit (docs/operations.md).
Restart=no
StateDirectory=willcord
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/willcord

[Install]
WantedBy=multi-user.target
