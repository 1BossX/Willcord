[Unit]
Description=Worker Plane online backup of the main database
After=worker-plane-main.service

[Service]
Type=oneshot
User=worker-plane
Group=worker-plane
Environment=DATA_DIR=/var/lib/worker-plane
WorkingDirectory=/opt/worker-plane/current/apps/server
UMask=0077
# Online: the main node keeps running. Backups older than 14 days are removed.
ExecStart=/bin/sh -c 'node dist/admin.js backup /var/backups/worker-plane/main-$(date +%%Y%%m%%d-%%H%%M%%S).sqlite'
ExecStartPost=/usr/bin/find /var/backups/worker-plane -name 'main-*.sqlite' -mtime +14 -delete
