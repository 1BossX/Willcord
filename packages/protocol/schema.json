{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkerFrame",
  "x-max-frame-bytes": 65536,
  "oneOf": [
    {
      "title": "WorkerFrame",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "type",
        "worker_id",
        "boot_id",
        "ledger_id",
        "workspaces"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "type": {
          "const": "register"
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workspaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspace_id",
              "config_version",
              "path",
              "repo_id",
              "is_default"
            ],
            "properties": {
              "workspace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "config_version": {
                "type": "integer",
                "minimum": 1
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "repo_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "is_default": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "worker_id",
        "connection_epoch",
        "type",
        "reconciliation_required"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "register_ack"
        },
        "reconciliation_required": {
          "const": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "worker_id", "connection_epoch", "type"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "heartbeat"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "worker_id", "connection_epoch", "type"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "resume"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "worker_id",
        "connection_epoch",
        "type",
        "ledger_id",
        "ready",
        "calls"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "reconcile"
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ready": {
          "type": "boolean"
        },
        "calls": {
          "description": "Every ledger entry the main node has not acknowledged. call_seq 0 marks a legacy entry whose sequence cannot be proven.",
          "type": "array",
          "maxItems": 128,
          "items": {
            "title": "CallReport",
            "type": "object",
            "additionalProperties": false,
            "required": ["job_id", "call_id", "call_seq", "request_hash", "status", "boot_id"],
            "properties": {
              "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "call_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "call_seq": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "status": {"enum": ["accepted", "running", "completed", "unknown"]},
              "boot_id": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "worker_id",
        "connection_epoch",
        "type",
        "ack_type"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "ack"
        },
        "ack_type": {
          "enum": ["resume", "reconcile"]
        }
      }
    },
    {
      "title": "ToolCall",
      "type": "object", "additionalProperties": false,
      "required": ["protocol_version","type","worker_id","connection_epoch","job_id","call_id","call_seq","workspace_id","config_version","request_hash","tool","arguments"],
      "properties": {
        "protocol_version":{"const":1},"type":{"const":"tool_call"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "call_seq":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "workspace_id":{"type":"string","minLength":1,"maxLength":128},
        "config_version":{"type":"integer","minimum":1},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "tool":{"enum":["read","write","bash"]},
        "arguments":{"type":"object"},
        "execution_mode":{"description":"diagnosis: read-only inspection allowlist. approved: post-approval write allowlist; tool and arguments must match an operator-approved binding carried in request_hash.","enum":["diagnosis","approved"]},
        "approved_binding_hash":{"description":"When execution_mode is approved, the SHA-256 binding of worker_id, tool, and arguments that the operator approved.","type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    {
      "title": "ToolResult",
      "type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","ok","result"],
      "properties": {
        "protocol_version":{"const":1},"type":{"const":"tool_result"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "ok":{"type":"boolean"},"result":{"type":"object"}
      }
    },
    {
      "title":"ToolData","type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","chunk_index","data","final"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"tool_data"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "chunk_index":{"type":"integer","minimum":0,"maximum":1000},
        "data":{"type":"string","maxLength":40000},"final":{"type":"boolean"}
      }
    },
    {
      "title":"ToolAck","type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","ack_through"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"tool_ack"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "ack_through":{"description":"Highest call_seq of this job whose result the main node has committed; the worker refuses older unseen calls.","type":"integer","minimum":1,"maximum":9007199254740991}
      }
    },
    {
      "title":"ToolAccepted","type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","boot_id"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"tool_accepted"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "boot_id":{"type":"string","minLength":1,"maxLength":128}
      }
    },
    {
      "title":"ToolRejected","type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","reason"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"tool_rejected"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "reason":{"enum":["conflict","unknown","retired","busy","disk_full","invalid","cancelled"]}
      }
    },
    {
      "title":"WorkerReady","type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","ready"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"worker_ready"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "ready":{"type":"boolean"}
      }
    },
    {
      "title":"CancelCall",
      "description":"Idempotent stop request. A call the ledger never accepted is fenced so it can never start.",
      "type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","call_seq","request_hash"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"cancel_call"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "call_seq":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    {
      "title":"CancelAck",
      "description":"Receipt only: termination is proven by the later tool_result. fenced proves the ledger never accepted the call.",
      "type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","state"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"cancel_ack"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "state":{"enum":["running","completed","fenced","unknown","conflict"]}
      }
    },
    {
      "title":"ToolLog",
      "description":"One stored output chunk, base64 of at most 16 KiB. Chunks are numbered from 0 per stream.",
      "type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","stream","seq","offset","data"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"tool_log"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "stream":{"enum":["stdout","stderr"]},
        "seq":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "offset":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "data":{"type":"string","maxLength":22000}
      }
    },
    {
      "title":"LogFetch","type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","stream","from_seq"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"log_fetch"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "stream":{"enum":["stdout","stderr"]},
        "from_seq":{"type":"integer","minimum":0,"maximum":9007199254740991}
      }
    },
    {
      "title":"LogStatus",
      "description":"Ends a log_fetch reply; chunks is the number of chunks stored for the stream.",
      "type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","stream","chunks","state"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"log_status"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "stream":{"enum":["stdout","stderr"]},
        "chunks":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "state":{"enum":["complete","more","running","expired"]}
      }
    },
    {
      "title":"LogAck",
      "description":"The main node holds every chunk it keeps of the stream. Independent of tool_ack.",
      "type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","stream","chunks"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"log_ack"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "stream":{"enum":["stdout","stderr"]},
        "chunks":{"type":"integer","minimum":0,"maximum":9007199254740991}
      }
    },
    {
      "title":"ResolveCall",
      "description":"An operator settled an unknown call; the worker keeps a tombstone so it never runs.",
      "type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","call_seq","request_hash"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"resolve_call"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "call_seq":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    {
      "title":"ResolveAck","type":"object","additionalProperties":false,
      "required":["protocol_version","type","worker_id","connection_epoch","job_id","call_id","request_hash","state"],
      "properties":{
        "protocol_version":{"const":1},"type":{"const":"resolve_ack"},
        "worker_id":{"type":"string","minLength":1,"maxLength":128},
        "connection_epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
        "job_id":{"type":"string","minLength":1,"maxLength":128},
        "call_id":{"type":"string","minLength":1,"maxLength":128},
        "request_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "state":{"enum":["resolved","not_unknown"]}
      }
    }
  ]
}
