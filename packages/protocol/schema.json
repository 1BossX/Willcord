    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "worker_id", "connection_epoch", "type"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "heartbeat"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "worker_id", "connection_epoch", "type"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "resume"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "worker_id",
        "connection_epoch",
        "type",
        "ledger_id",
        "ready"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "reconcile"
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ready": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "worker_id",
        "connection_epoch",
        "type",
        "ack_type"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
