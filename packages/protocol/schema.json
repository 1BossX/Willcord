      "properties": {
        "protocol_version": {
          "const": 1
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "connection_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "register_ack"
        },
        "reconciliation_required": {
          "const": true
